# ── 운영 필수 ──────────────────────────────
# 관리자 공용 비밀번호(길고 추측하기 어렵게)
ADMIN_PASSWORD=
# 로그인 쿠키 서명 키: 32자 이상 무작위 문자열 (예: openssl rand -hex 32)
SESSION_SECRET=
# Vercel에서 Neon / Blob을 연결하면 자동으로 들어갑니다.
DATABASE_URL=
BLOB_READ_WRITE_TOKEN=

# ── 선택 ──────────────────────────────────
# 알림 메일의 관리자 링크 주소(비우면 접수 요청 주소 사용)
APP_BASE_URL=
# 신규 접수 알림 메일(비우면 메일 대신 서버 로그에 기록)
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
NOTIFY_FROM=
# 여러 명이면 쉼표로 구분
NOTIFY_TO=

# ── 로컬 개발 전용 ─────────────────────────
# DB_PATH=memory      # 메모리 DB(재시작 시 초기화). 기본값은 ./data/pglite
# UPLOAD_DIR=./data/uploads

# 초안(데모) 배포 전용: DB·Blob 없이 메모리에 임시 저장. 운영에서는 비워 둘 것
# DEMO_MODE=1
